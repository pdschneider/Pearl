#!/bin/sh
# Runs after the files have been unpacked and the package is being configured
# This is where most of the 'setup' happens

set -e

# Repair desktop file if a legacy postrm deleted it during upgrade
if [ ! -f /usr/share/applications/pearl-gui.desktop ] \
   && [ -f /usr/share/pearl-gui/pearl-gui.desktop ]; then
    cp /usr/share/pearl-gui/pearl-gui.desktop /usr/share/applications/pearl-gui.desktop || true
    echo "Restored missing desktop entry"
fi

# Refresh desktop database and icon cache
if [ -x /usr/bin/update-icon-caches ]; then
    update-icon-caches /usr/share/icons/hicolor || true
elif [ -x /usr/bin/gtk-update-icon-cache ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

# Ensure the real binary is executable
chmod +x /usr/bin/pearl-gui

exit 0